# Copy this file to .env before starting the API.
# Never commit your real .env file.
ATHENA_ENVIRONMENT=development
ATHENA_DATABASE_URL=sqlite:///./athena.db
ATHENA_JWT_SECRET=replace-with-a-long-random-secret
ATHENA_ALLOWED_ORIGINS=http://localhost:8080
ATHENA_UNLOCK_ALL_LESSONS=false

# Renewable sign-in. Use the same host on every page (localhost and 127.0.0.1 differ).
ATHENA_PUBLIC_BASE_URL=http://127.0.0.1:8000
ATHENA_COOKIE_SECURE=false
ATHENA_ACCESS_TOKEN_EXPIRE_MINUTES=30
ATHENA_BROWSER_SESSION_HOURS=12
ATHENA_REMEMBER_DAYS=30

# Optional Google web OAuth client (no values means disabled)
ATHENA_GOOGLE_CLIENT_ID=
ATHENA_GOOGLE_CLIENT_SECRET=

# Apple requires a registered HTTPS domain and Apple Developer setup.
ATHENA_APPLE_CLIENT_ID=
ATHENA_APPLE_TEAM_ID=
ATHENA_APPLE_KEY_ID=
ATHENA_APPLE_PRIVATE_KEY=
